[run]
branch = True
data_file = .coverage
source=enterprise-subsidy
omit =
    enterprise_subsidy/settings/*
    enterprise_subsidy/conf/*
    */mocks.py
    */urls.py
    */wsgi.py
    */migrations/*
    */admin.py
    */static/*
    */templates/*
    */tests/*
    test_*

[html]
directory = build/coverage/html

[xml]
output = build/coverage/coverage.xml
